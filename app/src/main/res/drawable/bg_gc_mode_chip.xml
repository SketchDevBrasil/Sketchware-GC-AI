<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#25253A" />
            <stroke android:width="1dp" android:color="#32D8FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#11111D" />
            <stroke android:width="1dp" android:color="#3B3B52" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
